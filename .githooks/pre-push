#!/bin/sh
# Refuse to push private trading research to a PUBLIC repository.
#
# WHY THIS EXISTS. On 2026-08-20 a routine "push the fix" would have published
# 13,530 files to github.com/FerroxLabs/tvcontrol, which is public: the whole
# skills/market-open-report tree, TC-TIDE-PRO.pine, the strategy audits, the
# crypto findings and the copy briefs. origin/main had none of it. The only
# thing that stopped it was checking the file list first, which is not a control.
#
# The research now lives in ~/dev/tradingresearch. This hook is the seatbelt.
#
# IT SCANS HISTORY, NOT THE NET DIFF, AND THAT DISTINCTION IS THE WHOLE POINT.
# A push uploads every commit in the range, so a file that was added in one
# commit and deleted in a later one is still fully browsable on GitHub. A net
# diff shows it as absent. That is how this guard would have passed a push
# that published everything.
#
# Bypass deliberately with: git push --no-verify
# 2026-08-27: this guard was LIVE, INSTALLED AND EXECUTABLE, and it still let a private
# strategy skill through, because it names directories one at a time and the new one was
# called something else. A denylist of known names does not protect against the next name.
# `^skills/` is now matched broadly: this package ships generic connector skills, and a new
# skill directory here is far more likely to be strategy work than a connector feature, so
# the default is to STOP and make the author say so with --no-verify.
PATTERN='^skills/(market-open-report|tide-|tc-|strategy-research)|\.pine$|FINDINGS\.md$|^AUDIT|COPY-BRIEF|HANDOFF-.*\.md$|WHERE-THINGS-ARE'
ZERO=0000000000000000000000000000000000000000

# Every path touched by any commit being pushed, across the whole range.
paths_in_push() {
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue          # branch deletion, nothing uploads
    if [ "$remote_sha" = "$ZERO" ]; then
      # New branch. Everything not already on the remote is being uploaded.
      base=$(git merge-base origin/main "$local_sha" 2>/dev/null)
      if [ -n "$base" ]; then
        git log --name-only --pretty=format: "$base..$local_sha"
      else
        # No shared history to subtract. Scan the entire branch.
        git log --name-only --pretty=format: "$local_sha"
      fi
    else
      git log --name-only --pretty=format: "$remote_sha..$local_sha"
    fi
  done
}

# Read stdin ONCE. The previous version called its range function twice and the
# second call found stdin already consumed, so it always reported "0 files".
ALL=$(paths_in_push | grep -E "$PATTERN" | sort -u)

if [ -n "$ALL" ]; then
  COUNT=$(printf '%s\n' "$ALL" | wc -l | tr -d ' ')
  SHOWN=20
  echo "" >&2
  echo "PUSH BLOCKED: $COUNT private file(s) reachable from this push." >&2
  echo "github.com/FerroxLabs/tvcontrol is PUBLIC." >&2
  echo "" >&2
  printf '%s\n' "$ALL" | head -"$SHOWN" | sed 's/^/  /' >&2
  if [ "$COUNT" -gt "$SHOWN" ]; then
    echo "  ... and $((COUNT - SHOWN)) more not listed." >&2
  fi
  echo "" >&2
  echo "These are reachable from the commits being pushed even if a later" >&2
  echo "commit deleted them. Research belongs in ~/dev/tradingresearch." >&2
  echo "Land tvcontrol work on a branch built from origin/main instead." >&2
  echo "" >&2
  echo "If this is genuinely intended: git push --no-verify" >&2
  echo "" >&2
  exit 1
fi
exit 0
